# Copy to deploy/.env and fill in. Never commit the real .env.
# POSTGRES_PASSWORD and Auth__OtpSecret live in generated.env (made once on the server, see docker-compose.yml).

APP_PORT=8080

App__Name=DriveAlt
App__PublicUrl=https://drive.tryzarqa.com

# Sign-in: uni ID 24-0161 -> 24-0161@student.gutech.edu.om, one-time code by email.
Auth__EmailTemplate={id}@student.gutech.edu.om
# Uni IDs that are uploaders (add more with __1, __2 ...). Others can be promoted in the app.
Auth__Uploaders__0=24-0161
# Optional: only allow IDs starting with these (e.g. the batch year).
# Auth__AllowedPrefixes__0=24-

# Resend (the tryzarqa.com domain is already verified there).
Resend__ApiKey=
Resend__From=DriveAlt <noreply@tryzarqa.com>

# Gemini. Without a key the app still works in "offline" mode (PDF text layer, no question/answer regions).
Gemini__ApiKey=
Gemini__Model=gemini-3.8-flash
Gemini__EmbeddingModel=gemini-embedding-001

# Optional: DeepSeek runs the chat bot and reads pages when set (Gemini then only does embeddings).
DeepSeek__ApiKey=
DeepSeek__Model=deepseek-chat

# Optional: read pages through the Zarqa stack's private Codex gateway (ChatGPT login) instead. Chat is unaffected.
# A plan usage limit pauses the file for Codex__PauseMinutes and retries; pages are never read offline because of it.
Codex__BaseUrl=
Codex__Model=gpt-6.1-sol

# Optional: Google API key for import-drive (public folders also work without it).
Google__ApiKey=

Processing__Workers=2
Processing__PageConcurrency=3
